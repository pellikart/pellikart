# Same Supabase project as the web app (see ../.env) — one database, one source
# of truth. Only the variable prefix differs: Expo inlines EXPO_PUBLIC_* at
# build time the way Vite inlines VITE_*.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Razorpay (booking payments). Setting the KEY ID turns on the real gateway on
# native builds; leave it blank to keep the simulated booking (demo / web).
# The key ID is public (Razorpay puts it in the frontend). The SECRET lives only
# in the edge-function secrets — never in the app:
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=...
EXPO_PUBLIC_RAZORPAY_KEY_ID=
